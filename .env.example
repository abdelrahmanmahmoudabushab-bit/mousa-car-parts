# ========================================================
# MOUSA AUTO PARTS - SUPABASE CONFIGURATION
# Copy this file to .env and fill in your Supabase project credentials
# Obtain credentials from: https://supabase.com/dashboard/project/_/settings/api
# ========================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (For server-side bypass RLS)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
