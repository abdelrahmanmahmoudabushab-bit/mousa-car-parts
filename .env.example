# ========================================================
# MOUSA AUTO PARTS - SUPABASE CONFIGURATION
# Copy this file to .env and fill in your Supabase project credentials
# Obtain credentials from: https://supabase.com/dashboard/project/_/settings/api
# ========================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Railway Project ID
RAILWAY_PROJECT_ID=fd24d88f-e303-4a35-a2dd-b72638fbb825

